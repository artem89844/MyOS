mkdir -p build
cc -m32 -ffreestanding -fno-pic -fno-pie -c boot.S -o build/boot.o
cc -m32 -ffreestanding -fno-pic -fno-pie -c isr.S -o build/isr.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c kernel.c -o build/kernel.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c heap.c -o build/heap.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c ata.c -o build/ata.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c idt.c -o build/idt.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c pic.c -o build/pic.o
cc -m32 -std=gnu99 -O2 -Wall -Wextra -Wno-array-bounds -ffreestanding -fno-builtin -fno-stack-protector -fno-pic -fno-pie -fno-common -fno-asynchronous-unwind-tables -fno-unwind-tables -mno-mmx -mno-sse -mpreferred-stack-boundary=2 -mincoming-stack-boundary=2 -c string.c -o build/string.o
ld -m elf_i386 -T linker.ld -nostdlib -o kernel.bin build/boot.o build/isr.o build/kernel.o build/heap.o build/ata.o build/idt.o build/pic.o build/string.o
objcopy -O binary kernel.bin kernel.raw
